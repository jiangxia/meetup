# ===========================================
# AI酒馆配置文件模板
# ===========================================
# 使用说明: cp .env.example .env 然后编辑 .env 文件

# 🌐 服务器配置
PORT=3001
NODE_ENV=development

# 🤖 OpenAI API 配置
# 获取地址: https://platform.openai.com/api-keys
# ⚠️ 必填: 替换为您的真实API Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 🔗 MCP 连接配置
MCP_TRANSPORT=stdio
MCP_SERVER_COMMAND=promptx mcp

# 🛡️ 安全配置 (可选)
# 前端访问地址白名单
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# 🐛 调试配置 (可选)
# 开启详细日志输出
DEBUG_MCP=false
DEBUG_OPENAI=false

# 📊 性能配置 (可选)  
# OpenAI API 超时时间 (毫秒)
OPENAI_TIMEOUT=30000
# MCP 连接超时时间 (毫秒) 
MCP_TIMEOUT=10000

# 💾 会话配置 (可选)
# 默认会话ID
DEFAULT_SESSION_ID=default
# 最大记忆条数
MAX_MEMORIES=100